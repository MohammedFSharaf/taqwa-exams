rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // الإدارة: الحساب admin@taqwa.com فقط
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email', '') == 'admin@taqwa.com';
    }

    function signedIn() {
      return request.auth != null;
    }

    // ===== حماية التطبيق =====
    // قبل التفعيل: أي جهاز مسجّل دخولًا مجهولًا (كما كان).
    // بعد التفعيل من لوحة الإدارة: فقط الأجهزة التي تحقق السيرفر من كلمة سرها أو رمز شيخها.
    function enforced() {
      return exists(/databases/$(database)/documents/secrets/security)
        && get(/databases/$(database)/documents/secrets/security).data.get('enforce', false) == true;
    }
    function isDevice() {
      return signedIn() && exists(/databases/$(database)/documents/devices/$(request.auth.uid));
    }
    function isApp() {
      return isAdmin() || (signedIn() && (isDevice() || !enforced()));
    }
    // كلمة سر التطبيق أو رمز الشيخ — يقارنها السيرفر ولا يراها التطبيق
    function validCred(d) {
      return (d.get('pass', '') != ''
              && d.get('pass', '') == get(/databases/$(database)/documents/secrets/app).data.get('password', '#'))
        || (d.get('sheikhId', '') != '' && d.get('pin', '') != ''
              && d.get('pin', '') == get(/databases/$(database)/documents/secrets/pins).data.get(d.get('sheikhId', ''), '#'));
    }

    // الأسرار: كلمة السر ورموز المشايخ وحالة الحماية — الإدارة فقط
    match /secrets/{doc} {
      allow read, write: if isAdmin();
    }
    // الأجهزة المعتمدة: يسجّل الجهاز نفسه بكلمة سر صحيحة، والإدارة تقرأ وتلغي
    match /devices/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid && validCred(request.resource.data);
      allow delete: if isAdmin();
    }

    // الإعدادات (كلمة سر التطبيق)
    match /settings/{doc} {
      allow read: if isApp();
      allow write: if isAdmin();
    }

    // الحلقات والمختبرين: التطبيق يقرأ فقط
    match /halaqat/{id} {
      allow read: if signedIn(); // أسماء الحلقات تظهر في شاشة دخول الشيخ
      allow write: if isAdmin();
    }
    match /examiners/{id} {
      allow read: if isApp();
      allow write: if isAdmin();
    }

    // الطلاب: التطبيق يقرأ ويضيف طالب جديد بحالة "pending" فقط
    match /students/{id} {
      allow read: if isApp();
      allow create: if isAdmin()
        || (isApp()
            && request.resource.data.status == 'pending'
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 100);
      allow update, delete: if isAdmin();
    }

    // البيانات الشخصية للطلاب (الميلاد، ولي الأمر، الجوال، السكن...): الإدارة فقط
    match /studentInfo/{id} {
      allow read, write: if isAdmin();
    }

    // أذونات إعادة اختبار ناجح: الإدارة فقط تكتب، والتطبيق يقرأ
    match /permits/{id} {
      allow read: if isApp();
      allow write: if isAdmin();
    }

    // ===== السجل اليومي =====
    // حسابات المشايخ: الإدارة تكتب، والتطبيق يقرأ
    match /sheikhs/{id} {
      allow read: if signedIn(); // الأسماء فقط (الرموز في secrets/pins)
      allow write: if isAdmin();
    }
    // سجل كل طالب لكل يوم
    match /logs/{id} {
      allow read: if isApp();
      allow create, update: if isApp();
      allow delete: if isAdmin();
    }
    // نقطة بداية الطالب في السجل اليومي
    match /progress/{id} {
      allow read: if isApp();
      allow create, update: if isApp();
      allow delete: if isAdmin();
    }
    // الإجازات: إجازة المركز من الإدارة فقط، وإجازة الحلقة من الشيخ أو الإدارة
    match /holidays/{id} {
      allow read: if isApp();
      allow create: if isAdmin() || (isApp() && request.resource.data.halaqaId != 'all');
      allow delete: if isAdmin() || (isApp() && resource.data.halaqaId != 'all');
      allow update: if isAdmin();
    }

    // سجل التعديلات: يُضاف فقط (لا تعديل ولا حذف)، والإدارة فقط تقرأ
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if isApp();
      allow update, delete: if false;
    }

    // الاختبارات: التطبيق يقرأ الكل (لمعرفة الإعادة) ويضيف فقط، والتعديل والحذف للإدارة
    match /exams/{id} {
      allow read: if isApp();
      allow create: if isAdmin()
        || (isApp() && request.resource.data.authorUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
