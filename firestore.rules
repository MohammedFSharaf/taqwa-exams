rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // الإدارة: الحساب admin@taqwa.com فقط
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email', '') == 'admin@taqwa.com';
    }

    // أي جهاز عليه التطبيق (دخول مجهول)
    function isApp() {
      return request.auth != null;
    }

    // الإعدادات (كلمة سر التطبيق)
    match /settings/{doc} {
      allow read: if isApp();
      allow write: if isAdmin();
    }

    // الحلقات والمختبرين: التطبيق يقرأ فقط
    match /halaqat/{id} {
      allow read: if isApp();
      allow write: if isAdmin();
    }
    match /examiners/{id} {
      allow read: if isApp();
      allow write: if isAdmin();
    }

    // الطلاب: التطبيق يقرأ ويضيف طالب جديد بحالة "pending" فقط
    match /students/{id} {
      allow read: if isApp();
      allow create: if isAdmin()
        || (isApp()
            && request.resource.data.status == 'pending'
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0);
      allow update, delete: if isAdmin();
    }

    // أذونات إعادة اختبار ناجح: الإدارة فقط تكتب، والتطبيق يقرأ
    match /permits/{id} {
      allow read: if isApp();
      allow write: if isAdmin();
    }

    // ===== السجل اليومي =====
    // حسابات المشايخ: الإدارة تكتب، والتطبيق يقرأ
    match /sheikhs/{id} {
      allow read: if isApp();
      allow write: if isAdmin();
    }
    // سجل كل طالب لكل يوم
    match /logs/{id} {
      allow read: if isApp();
      allow create, update: if isApp();
      allow delete: if isAdmin();
    }
    // نقطة بداية الطالب في السجل اليومي
    match /progress/{id} {
      allow read: if isApp();
      allow create, update: if isApp();
      allow delete: if isAdmin();
    }
    // الإجازات: إجازة المركز من الإدارة فقط، وإجازة الحلقة من الشيخ أو الإدارة
    match /holidays/{id} {
      allow read: if isApp();
      allow create: if isAdmin() || (isApp() && request.resource.data.halaqaId != 'all');
      allow delete: if isAdmin() || (isApp() && resource.data.halaqaId != 'all');
      allow update: if isAdmin();
    }

    // سجل التعديلات: يُضاف فقط (لا تعديل ولا حذف)، والإدارة فقط تقرأ
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if isApp();
      allow update, delete: if false;
    }

    // الاختبارات: التطبيق يقرأ الكل (لمعرفة الإعادة) ويضيف فقط، والتعديل والحذف للإدارة
    match /exams/{id} {
      allow read: if isApp();
      allow create: if isAdmin()
        || (isApp() && request.resource.data.authorUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
